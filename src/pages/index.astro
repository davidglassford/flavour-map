---
import Layout from '../layouts/Layout.astro';
import FlavourMap from '../components/FlavourMap.vue';
---

<Layout title="Global Flavour Explorer">
  <div class="flex h-[72px] items-center justify-between border-b border-cf-carbon bg-cf-white px-12">
    <div class="font-display text-lg font-bold tracking-[-0.011em]">Global Flavour Explorer</div>
    <div class="text-xs uppercase tracking-[0.03em] text-cf-muted-grey">KS4 · Food &amp; Vocabulary</div>
  </div>

  <div class="bg-cf-cloud px-12 py-8 text-cf-carbon">
    <div class="mx-auto max-w-[900px] text-center">
      <h1 class="text-[clamp(26px,3.4vw,36px)] text-cf-carbon">Where does flavour come from?</h1>
      <p class="mx-auto mt-4 max-w-[640px] text-[15px] leading-[1.8] font-light text-cf-ink-muted">
        Every region of the world cooks with its own signature ingredients. Explore the map, click a region, and
        build the vocabulary to describe how food really tastes.
      </p>
    </div>
  </div>

  <div class="mx-auto max-w-[1440px] px-12 py-16">
    <div class="mb-8 text-center">
      <div class="text-xs uppercase tracking-[0.03em] text-cf-midnight">The map</div>
      <h2 class="mt-2 text-[36px]">Click a region to explore its flavours</h2>
      <p class="mx-auto mt-4 max-w-[620px] text-cf-ink-muted">
        Ten flavour regions are highlighted below, matched to the flavour wheel. Grey areas aren't covered yet. Open
        a region to expand individual countries and their signature foods.
      </p>
    </div>

    <FlavourMap client:load />
  </div>

  <footer class="border-t border-cf-carbon px-12 py-8 text-center text-[13px] text-cf-muted-grey">
    Global Flavour Explorer &middot; built for KS4 Food &amp; Vocabulary lessons
  </footer>
</Layout>
