---
import Layout from '../layouts/Layout.astro';

const items = [
  {
    title: 'Global Flavour Explorer',
    description: 'Explore ten flavour regions of the world, build the vocabulary to successfully evaluate dishes.',
    href: '/flavour-map',
    eyebrow: 'Interactive map',
  },
];
---

<Layout title="Food Technology">
  <div class="flex h-18 items-center border-b border-cf-carbon bg-cf-white px-12">
    <div class="font-display text-lg font-bold tracking-[-0.011em]">Food Technology</div>
  </div>

  <div class="bg-cf-cloud px-12 py-8 text-cf-carbon">
    <div class="mx-auto max-w-225 text-center">
      <h1 class="text-[clamp(26px,3.4vw,36px)] text-cf-carbon">Food Technology</h1>
      <p class="mx-auto mt-4 max-w-160 text-[15px] leading-[1.8] font-light text-cf-ink-muted">
        Resources to help you build knowledge and confidence in food technology.
      </p>
    </div>
  </div>

  <div class="mx-auto max-w-360 px-12 py-16">
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        items.map((item) => (
          <a
            href={item.href}
            class="group block rounded-lg border border-cf-divider bg-cf-white p-6 transition-colors hover:border-cf-midnight"
          >
            <div class="text-xs uppercase tracking-[0.03em] text-cf-midnight">{item.eyebrow}</div>
            <h2 class="mt-2 text-[22px] group-hover:text-cf-midnight">{item.title}</h2>
            <p class="mt-3 text-[15px] leading-[1.6] text-cf-ink-muted">{item.description}</p>
          </a>
        ))
      }
    </div>
  </div>
</Layout>
