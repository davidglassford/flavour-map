---
import Layout from '../layouts/Layout.astro';
import FlavourMap from '../components/FlavourMap.vue';
---

<Layout title="Global Flavour Explorer">
  <div class="flex h-18 items-center border-b border-cf-carbon bg-cf-white px-12">
    <a href="/" class="font-display text-lg font-bold tracking-[-0.011em]">Global Flavour Explorer</a>
  </div>

  <div class="bg-cf-cloud px-12 py-8 text-cf-carbon">
    <div class="mx-auto max-w-225 text-center">
      <h1 class="text-[clamp(26px,3.4vw,36px)] text-cf-carbon">Where does flavour come from?</h1>
      <p class="mx-auto mt-4 max-w-160 text-[15px] leading-[1.8] font-light text-cf-ink-muted">
        Every region of the world cooks with its own signature ingredients. Explore the map, click a region, and
        build the vocabulary to describe how food really tastes.
      </p>
    </div>
  </div>

  <div class="mx-auto max-w-360 px-4 py-16 sm:px-12">
    <div class="mb-8 text-center">
      <div class="text-xs uppercase tracking-[0.03em] text-cf-midnight">The map</div>
      <h2 class="mt-2 text-[36px]">Click a region to explore its flavours</h2>
      <p class="mx-auto mt-4 max-w-155 text-center text-cf-ink-muted">
        Ten flavour regions are highlighted below. Open a region to expand individual countries and their signature
        foods.
      </p>
    </div>

    <FlavourMap client:load />
  </div>
</Layout>
