---

<Layout title="Image Credits">
  <div class="flex h-18 items-center border-b border-cf-carbon bg-cf-white px-12">
    <a href="/" class="font-display text-lg font-bold tracking-[-0.011em]">Food Technology</a>
  </div>

  <div class="bg-cf-cloud px-12 py-8 text-cf-carbon">
    <div class="mx-auto max-w-225 text-center">
      <h1 class="text-[clamp(26px,3.4vw,36px)] text-cf-carbon">Image credits</h1>
      <p class="mx-auto mt-4 max-w-160 text-[15px] leading-[1.8] font-light text-cf-ink-muted">
        Photos on the Global Flavour Explorer are sourced from Wikimedia Commons and Flickr under public domain or
        Creative Commons licences. Attribution is provided below where the licence requires it.
      </p>
    </div>
  </div>

  <div class="mx-auto max-w-225 px-12 py-16">
    <ul class="divide-y divide-cf-divider">
      {
        credits.map((credit) => (
          <li class="flex flex-wrap items-baseline justify-between gap-2 py-3">
            <span class="text-[15px] text-cf-carbon">{credit.item}</span>
            <span class="text-sm text-cf-ink-muted">
              {credit.author && <>{credit.author} via </>}
              <a href={credit.source} class="text-cf-midnight underline underline-offset-2" target="_blank" rel="noopener noreferrer">
                {credit.sourceLabel}
              </a>
              {' · '}
              {credit.license}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</Layout>
